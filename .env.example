# ==========================================
# Carnival Job Runner - Environment Configuration
# ==========================================

# --- General Configuration ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database Credentials (MSSQL) ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# MSSQL Server 211 (Inventory & Dimensions)
DB_SERVER_211=10.1.1.211
DB_DATABASE_CTRL=CTRLINVENT
DB_DATABASE_COL=ColeccionIntima

# Dynamics AX ERP Server
DB_SERVER_AX=10.1.1.212
DB_DATABASE_AX=DynamicsAX

# Local Tracking / Packing SQL Server
DB_SERVER_SQL=170.1.1.10
DB_DATABASE_SQL=SeguimientoPedidos

# --- Target APIs ---

# Styles Information API (Inventory & Dimensions)
STYLES_API_BASE_URL=https://carnivaldevelop.ddns.net/stylesInformation/api

# LiveDash Endpoints
LIVEDASH_SOURCE_URL=http://170.1.1.10:8012
LIVEDASH_TARGET_URL=http://localhost:3000/api/livedash
LIVEDASH_SYNC_KEY=livedash-secret-key

# Internal Sync API (Logbook / Courier)
SYNC_API_URL=http://localhost:3000/api/sync
SYNC_API_KEY=your-sync-api-key
