{
  "name": "job-runner",
  "version": "1.0.0",
  "description": "Background task scheduler and data synchronization worker for Carnival",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:pm2": "npm run build && pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop ecosystem.config.cjs",
    "restart:pm2": "npm run build && pm2 restart ecosystem.config.cjs",
    "logs:pm2": "pm2 logs carnival-job-runner",
    "task:inventory": "tsx src/tasks/updateInventory/cli.ts",
    "task:dimensions": "tsx src/tasks/updateDimensions/cli.ts",
    "task:livedash": "tsx src/tasks/livedashPush/cli.ts",
    "task:logbook": "tsx src/tasks/logbookUpdateDB/cli.ts"
  },
  "keywords": [
    "cron",
    "scheduler",
    "etl",
    "data-sync",
    "worker",
    "pm2"
  ],
  "author": "Carnival",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "mssql": "^12.5.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^25.6.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
